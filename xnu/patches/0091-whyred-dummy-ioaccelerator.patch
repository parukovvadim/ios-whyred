+class IOAcceleratorESUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOAcceleratorESUserClient);
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorESUserClient, IOUserClient);
+
+bool
+IOAcceleratorESUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	return true;
+}
+
+IOReturn
+IOAcceleratorESUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOAcceleratorESUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET ACCEL: %s sel %u in %u/%u out %u/%u\n", name, selector,
+	    args ? args->scalarInputCount : 0, args ? args->structureInputSize : 0,
+	    args ? args->scalarOutputCount : 0, args ? args->structureOutputSize : 0);
+	return kIOReturnUnsupported;
+}
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOAcceleratorESUserClient");
+	registerService();
+	IOLog("SWEET ACCEL: IOAcceleratorES registered\n");
+	return true;
+}
