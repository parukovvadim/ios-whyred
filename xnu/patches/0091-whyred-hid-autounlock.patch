+			gSweetTouch->touch(0, false, 540, 200);
+		}
+		sender->setTimeoutMS(500);
+		break;
+	default:
+		/* Rest between unlock attempts: 10s */
+		sender->setTimeoutMS(10 * 1000);
+		break;
+	}
 
