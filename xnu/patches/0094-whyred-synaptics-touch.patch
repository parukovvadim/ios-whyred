+++ b/bsd/dev/whyred_touch.c
@@ -0,0 +1,330 @@
+/*
+ * whyred_touch.c: Polled BLSP1 QUP1 I2C driver for Synaptics DSX (RMI4)
+ * on Xiaomi Redmi Note 5 / Pro (whyred, Qualcomm SDM636 / SDM660).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void whyred_touch_init(void);
+
+#define WHYRED_QUP_PA        0x0c175000u
+#define WHYRED_GCC_PA        0x00100000u
+#define WHYRED_TLMM_PA       0x03000000u
+
+#define QUP_CONFIG           0x000u
+#define QUP_STATE            0x004u
+#define QUP_IO_MODE          0x008u
+#define QUP_SW_RESET         0x00cu
+#define QUP_OPERATIONAL      0x018u
+#define QUP_ERROR_FLAGS      0x01cu
+#define QUP_HW_VERSION       0x030u
+#define QUP_MX_OUTPUT_CNT    0x100u
+#define QUP_OUT_FIFO_BASE    0x110u
+#define QUP_MX_WRITE_CNT     0x150u
+#define QUP_MX_INPUT_CNT     0x200u
+#define QUP_MX_READ_CNT      0x208u
+#define QUP_IN_FIFO_BASE     0x218u
+#define QUP_I2C_CLK_CTL      0x400u
+#define QUP_I2C_STATUS       0x404u
+
+#define QUP_RESET_STATE      0u
+#define QUP_RUN_STATE        1u
+#define QUP_PAUSE_STATE      3u
+#define QUP_STATE_MASK       3u
+#define QUP_STATE_VALID      (1u << 2)
+
+#define QUP_TAG_START        (1u << 8)
+#define QUP_TAG_DATA         (2u << 8)
+#define QUP_TAG_STOP         (3u << 8)
+#define QUP_TAG_REC          (4u << 8)
+
+#define QUP_OUT_SVC_FLAG     (1u << 8)
+#define QUP_IN_SVC_FLAG      (1u << 9)
+#define QUP_IN_NOT_EMPTY     (1u << 5)
+
+static vm_offset_t wt_qup, wt_gcc, wt_tlmm;
+static int wt_sleep_chan;
+static uint8_t wt_f12_data_base = 0;
+static uint8_t wt_f11_data_base = 0;
+static bool wt_has_f12 = false;
+static bool wt_has_f11 = false;
+static bool wt_touch_down = false;
+
+static inline uint32_t
+wt_rd(vm_offset_t base, uint32_t reg)
+{
+	return *(volatile uint32_t *)(base + reg);
+}
+
+static inline void
+wt_wr(vm_offset_t base, uint32_t reg, uint32_t val)
+{
+	*(volatile uint32_t *)(base + reg) = val;
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+wt_delay_ms(uint32_t ms)
+{
+	extern int hz;
+	if (hz > 0 && ms >= 10) {
+		uint32_t ticks = (ms * (uint32_t)hz) / 1000u;
+		if (ticks < 1) ticks = 1;
+		(void)tsleep(&wt_sleep_chan, PZERO, "wttouch", ticks);
+	} else {
+		delay(ms * 1000);
+	}
+}
+
+static int
+wt_qup_wait_state(uint32_t state)
+{
+	for (int i = 0; i < 2000; i++) {
+		uint32_t s = wt_rd(wt_qup, QUP_STATE);
+		if ((s & QUP_STATE_VALID) && ((s & QUP_STATE_MASK) == state)) {
+			return 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static int
+wt_qup_write(uint8_t addr, const uint8_t *buf, unsigned len)
+{
+	wt_wr(wt_qup, QUP_SW_RESET, 1);
+	if (wt_qup_wait_state(QUP_RESET_STATE) != 0) return -1;
+
+	wt_wr(wt_qup, QUP_CONFIG, 0);
+	wt_wr(wt_qup, QUP_IO_MODE, 0xc000); /* REPACK_EN */
+	wt_wr(wt_qup, QUP_MX_WRITE_CNT, len + 1);
+	wt_wr(wt_qup, QUP_I2C_CLK_CTL, (3 << 8) | 21); /* 400kHz from 19.2MHz */
+
+	wt_wr(wt_qup, QUP_STATE, QUP_RUN_STATE);
+	if (wt_qup_wait_state(QUP_RUN_STATE) != 0) return -1;
+	wt_wr(wt_qup, QUP_STATE, QUP_PAUSE_STATE);
+	if (wt_qup_wait_state(QUP_PAUSE_STATE) != 0) return -1;
+
+	/* Issue START + address */
+	uint32_t val = QUP_TAG_START | ((uint32_t)addr << 1);
+	unsigned pos = 0;
+	while (pos < len) {
+		uint32_t tag = (pos == len - 1) ? QUP_TAG_STOP : QUP_TAG_DATA;
+		val |= (tag | buf[pos]) << 16;
+		wt_wr(wt_qup, QUP_OUT_FIFO_BASE, val);
+		pos++;
+		if (pos < len) {
+			tag = (pos == len - 1) ? QUP_TAG_STOP : QUP_TAG_DATA;
+			val = tag | buf[pos];
+			pos++;
+			if (pos == len) {
+				wt_wr(wt_qup, QUP_OUT_FIFO_BASE, val);
+			}
+		}
+	}
+
+	wt_wr(wt_qup, QUP_STATE, QUP_RUN_STATE);
+	if (wt_qup_wait_state(QUP_RUN_STATE) != 0) return -1;
+
+	for (int i = 0; i < 5000; i++) {
+		uint32_t op = wt_rd(wt_qup, QUP_OPERATIONAL);
+		uint32_t err = wt_rd(wt_qup, QUP_ERROR_FLAGS);
+		uint32_t st = wt_rd(wt_qup, QUP_I2C_STATUS);
+		if (err || (st & 0x38000fcu)) {
+			wt_wr(wt_qup, QUP_STATE, QUP_RESET_STATE);
+			return -2;
+		}
+		if (op & QUP_OUT_SVC_FLAG) {
+			wt_wr(wt_qup, QUP_OPERATIONAL, QUP_OUT_SVC_FLAG);
+			break;
+		}
+		delay(1);
+	}
+
+	wt_wr(wt_qup, QUP_STATE, QUP_RESET_STATE);
+	return 0;
+}
+
+static int
+wt_qup_read(uint8_t addr, uint8_t *buf, unsigned len)
+{
+	wt_wr(wt_qup, QUP_SW_RESET, 1);
+	if (wt_qup_wait_state(QUP_RESET_STATE) != 0) return -1;
+
+	wt_wr(wt_qup, QUP_CONFIG, 0);
+	wt_wr(wt_qup, QUP_IO_MODE, 0xc000); /* REPACK_EN */
+	wt_wr(wt_qup, QUP_MX_READ_CNT, len);
+	wt_wr(wt_qup, QUP_I2C_CLK_CTL, (3 << 8) | 21);
+
+	wt_wr(wt_qup, QUP_STATE, QUP_RUN_STATE);
+	if (wt_qup_wait_state(QUP_RUN_STATE) != 0) return -1;
+	wt_wr(wt_qup, QUP_STATE, QUP_PAUSE_STATE);
+	if (wt_qup_wait_state(QUP_PAUSE_STATE) != 0) return -1;
+
+	uint32_t val = ((QUP_TAG_REC | len) << 16) | QUP_TAG_START | ((uint32_t)addr << 1) | 1u;
+	wt_wr(wt_qup, QUP_OUT_FIFO_BASE, val);
+	wt_wr(wt_qup, QUP_STATE, QUP_RUN_STATE);
+	if (wt_qup_wait_state(QUP_RUN_STATE) != 0) return -1;
+
+	unsigned pos = 0;
+	for (int i = 0; i < 5000 && pos < len; i++) {
+		uint32_t op = wt_rd(wt_qup, QUP_OPERATIONAL);
+		if (op & QUP_IN_SVC_FLAG) {
+			wt_wr(wt_qup, QUP_OPERATIONAL, QUP_IN_SVC_FLAG);
+		}
+		if (op & QUP_IN_NOT_EMPTY) {
+			uint32_t w = wt_rd(wt_qup, QUP_IN_FIFO_BASE);
+			buf[pos++] = w & 0xff;
+			if (pos < len) buf[pos++] = (w >> 16) & 0xff;
+		}
+		delay(1);
+	}
+
+	wt_wr(wt_qup, QUP_STATE, QUP_RESET_STATE);
+	return pos == len ? 0 : -1;
+}
+
+static int
+wt_rmi_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	if (wt_qup_write(0x20, &reg, 1) != 0) return -1;
+	return wt_qup_read(0x20, buf, len);
+}
+
+static void
+whyred_touch_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+
+	printf("WHYRED TOUCH: thread started\n");
+	wt_delay_ms(100);
+
+	/* 1. Setup clocks */
+	/* blsp1_ahb_clk: enable reg 0x52004, bit 17 */
+	wt_wr(wt_gcc, 0x52004, wt_rd(wt_gcc, 0x52004) | (1u << 17));
+	/* blsp1_qup1_i2c_apps_clk_src (RCG): XO parent (0), div 1 (cfg = 0) */
+	wt_wr(wt_gcc, 0x19024, wt_rd(wt_gcc, 0x19024) & ~0x371fu);
+	wt_wr(wt_gcc, 0x19020, wt_rd(wt_gcc, 0x19020) | 1u); /* RCG update */
+	/* blsp1_qup1_i2c_apps_clk branch enable */
+	wt_wr(wt_gcc, 0x19008, wt_rd(wt_gcc, 0x19008) | 1u);
+
+	/* 2. Setup TLMM GPIOs (SDM636 Base 0x03000000) */
+	/* Pin 2 (SDA): 0x2000, func 3 (blsp_i2c1) */
+	wt_wr(wt_tlmm, 0x2000, (3u << 2) | 0u);
+	/* Pin 3 (SCL): 0x3000, func 3 (blsp_i2c1) */
+	wt_wr(wt_tlmm, 0x3000, (3u << 2) | 0u);
+
+	/* Pin 66 (Reset): 0x42000, GPIO output */
+	wt_wr(wt_tlmm, 0x42000, 0x200u); /* output enabled */
+	/* Active LOW pulse: drive low for 20ms */
+	wt_wr(wt_tlmm, 0x42004, 0u);
+	delay(20000);
+	/* Drive high and wait 200ms */
+	wt_wr(wt_tlmm, 0x42004, 2u);
+	delay(200000);
+
+	/* Pin 67 (IRQ): 0x43000, GPIO input, pull-up (bits 1:0 = 3) */
+	wt_wr(wt_tlmm, 0x43000, 0x03u);
+
+	uint32_t hw_ver = wt_rd(wt_qup, QUP_HW_VERSION);
+	printf("WHYRED TOUCH: QUP HW_VERSION=0x%08x\n", hw_ver);
+
+	/* 3. Probe Synaptics DSX (RMI4) at 0x20: Scan PDT */
+	for (uint8_t addr = 0xe9; addr >= 0x05; addr -= 6) {
+		uint8_t desc[6] = {0};
+		if (wt_rmi_read(addr, desc, 6) != 0) {
+			continue;
+		}
+		if (desc[5] == 0x00) break; /* End of PDT */
+
+		if (desc[5] == 0x12) {
+			wt_f12_data_base = desc[3];
+			wt_has_f12 = true;
+			printf("WHYRED TOUCH: found RMI4 F12 (2D sensor) data_base=0x%02x\n", wt_f12_data_base);
+		} else if (desc[5] == 0x11) {
+			wt_f11_data_base = desc[3];
+			wt_has_f11 = true;
+			printf("WHYRED TOUCH: found RMI4 F11 (2D sensor) data_base=0x%02x\n", wt_f11_data_base);
+		}
+	}
+
+	if (!wt_has_f12 && !wt_has_f11) {
+		printf("WHYRED TOUCH: Synaptics RMI4 not responding or PDT empty, falling back to polling\n");
+		wt_f12_data_base = 0x01;
+		wt_has_f12 = true;
+	}
+
+	/* 4. Main event loop */
+	for (;;) {
+		wt_delay_ms(10);
+
+		/* Check IRQ Pin 67 (active low, bit 0 of 0x43004). */
+		bool touched = ((wt_rd(wt_tlmm, 0x43004) & 1u) == 0);
+		if (!touched) {
+			if (wt_touch_down) {
+				wt_touch_down = false;
+				sweet_hid_touch(0, 0, 0, 0);
+			}
+			continue;
+		}
+
+		if (wt_has_f12) {
+			uint8_t report[8] = {0};
+			if (wt_rmi_read(wt_f12_data_base, report, 8) == 0) {
+				uint8_t status = report[0];
+				if (status == 1 || status == 2) {
+					int x = (int)report[1] | (((int)report[2]) << 8);
+					int y = (int)report[3] | (((int)report[4]) << 8);
+					/* Clip to screen boundary 1080x2160 */
+					x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
+					y = y < 0 ? 0 : (y > 2159 ? 2159 : y);
+					wt_touch_down = true;
+					sweet_hid_touch(0, 1, x, y);
+				} else if (wt_touch_down) {
+					wt_touch_down = false;
+					sweet_hid_touch(0, 0, 0, 0);
+				}
+			}
+		}
+	}
+}
+
+void
+whyred_touch_init(void)
+{
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("whyredtouch", &on, sizeof(on));
+	if (!on) {
+		printf("WHYRED TOUCH: disabled (whyredtouch=0)\n");
+		return;
+	}
+
+	wt_qup = ml_io_map(WHYRED_QUP_PA, 0x1000);
+	wt_gcc = ml_io_map(WHYRED_GCC_PA, 0x60000);
+	wt_tlmm = ml_io_map(WHYRED_TLMM_PA, 0x60000);
+
+	if (!wt_qup || !wt_gcc || !wt_tlmm) {
+		printf("WHYRED TOUCH: failed to map MMIO\n");
+		return;
+	}
+
+	thread_t th;
+	if (kernel_thread_start(whyred_touch_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		printf("WHYRED TOUCH: initialized successfully\n");
+	} else {
+		printf("WHYRED TOUCH: failed to start thread\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
