+volatile uint32_t *sweet_fb_ptr = NULL;
+_Atomic uint32_t sweet_core_irq_counts[4] = {0, 0, 0, 0};
+
+void
+sweet_core_irq_tick(unsigned int cpuid)
+{
+	if (cpuid >= 4) return;
+	uint32_t t = os_atomic_inc_orig(&sweet_core_irq_counts[cpuid], relaxed) + 1;
+
+	/* Draw every 32 ticks (~100ms at ~300Hz timer rate) */
+	if ((t & 31) == 0) {
+		volatile uint32_t *fb = sweet_fb_ptr;
+		if (fb) {
+			/* Blinking color: Bright Green (0x00FF00) vs Dark Green (0x002200) */
+			uint32_t color = (t & 32) ? 0x00FF00u : 0x002200u;
+			int x_start = 60 + (int)cpuid * 260;
+			for (int y = 20; y < 55; y++) {
+				for (int x = x_start; x < x_start + 160; x++) {
+					fb[y * 1080 + x] = color;
+				}
+			}
+			__asm__ volatile("dsb sy; isb" ::: "memory");
+		}
+	}
+}
+
+static volatile uint32_t *sweet_wdt_ptr = NULL;
+static void
+sweet_pet_hw_watchdog(void)
+{
+	if (!sweet_wdt_ptr) {
+		extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+		sweet_wdt_ptr = (volatile uint32_t *)ml_io_map(0x17817000u, 0x1000u);
+		if (sweet_wdt_ptr) {
+			sweet_wdt_ptr[0x08 / 4] = 0;
+			printf("SWEET WDT: disabled APSS HW watchdog at 0x17817000\n");
+		}
+	}
+	if (sweet_wdt_ptr) {
+		sweet_wdt_ptr[0x08 / 4] = 0;
+		sweet_wdt_ptr[0x04 / 4] = 1;
+	}
+}
 
