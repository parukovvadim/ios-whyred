 	uint32_t n = 0;
 
-	if (nblocks == 0 || len > BOUNCE_SIZE) {
+	if (nblocks == 0 || len > (SD_MAX_CHUNK_BLOCKS * UFS_BLOCK)) {
 		return EINVAL;
 	}
 	for (uint32_t done = 0; done < len; done += ADMA_CHUNK, n++) {
@@ -202,23 +204,36 @@ sd_xfer(uint32_t sector, uint32_t nblocks, bool write)
 	d[n - 1].attr = 0x23;
 	dma_sync(DMA_UCD, n * (uint32_t)sizeof(*d));
 	if (su.cache && write) {
-		dma_clean(DMA_BOUNCE, len);
