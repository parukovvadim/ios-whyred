+
+static int
+sd_xfer_chunk(uint32_t sector, uint32_t nblocks, bool write, uint32_t bounce_off)
+{
+	int error = 0;
+	for (int retry = 0; retry < 2; retry++) {
+		error = sd_xfer_one(sector, nblocks, write, bounce_off);
+		if (error == 0) {
+			return 0;
+		}
+		printf("SWEET SDHCI: retrying CMD on sector 0x%x x%u (attempt %d, error %d)\n",
+		    sector, nblocks, retry + 1, error);
+		sd_reset_lines();
+		delay(50);
+	}
+	return error;
+}
+
+static int
+sd_xfer(uint32_t sector, uint32_t nblocks, bool write)
+{
+	if (nblocks == 0) {
+		return 0;
+	}
+	if (nblocks * UFS_BLOCK > BOUNCE_SIZE) {
+		return EINVAL;
+	}
+	uint32_t remaining = nblocks;
+	uint32_t sec = sector;
+	uint32_t buf_off = 0;
+
+	while (remaining > 0) {
+		uint32_t chunk_blocks = MIN(remaining, SD_MAX_CHUNK_BLOCKS);
+		int error = sd_xfer_chunk(sec, chunk_blocks, write, buf_off);
+		if (error) {
+			return error;
+		}
+		sec += chunk_blocks;
+		remaining -= chunk_blocks;
+		buf_off += chunk_blocks * UFS_BLOCK;
 	}
 	return 0;
 }
