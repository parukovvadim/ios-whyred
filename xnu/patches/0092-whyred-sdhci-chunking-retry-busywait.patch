-			printf("SWEET SDHCI: inhibit stuck, state %08x\n", ufs_rd(SD_PRES));
+			printf("SWEET SDHCI: card busy on DAT0 before CMD, state %08x\n", ufs_rd(SD_PRES));
 			sd_reset_lines();
 			return EBUSY;
 		}
 		delay(1);
 	}
+
 	uint32_t idx = write ? (nblocks > 1 ? 25 : 24) : (nblocks > 1 ? 18 : 17);
 	uint32_t tm = 0x03 | (nblocks > 1 ? 0x24 : 0) | (write ? 0 : 0x10);
 	ufs_wr(SD_ISTS, 0xffffffff);
@@ -231,7 +246,7 @@ sd_xfer(uint32_t sector, uint32_t nblocks, bool write)
 	uint32_t ists;
 	for (;;) {
 		ists = ufs_rd(SD_ISTS);
-		if (ists & (1u << 15)) {
